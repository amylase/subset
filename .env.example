# Copy to .env and fill in. .env is gitignored.

# --- credentials -------------------------------------------------------------
# Devin service-user token (Settings -> Service users -> Generate API key).
# Shown once only.
DEVIN_API_KEY=cog_...
# Shown on the same Settings -> Service users page, or via GET /v3/self.
DEVIN_ORG_ID=org-...

# Fine-grained PAT scoped to the target repository:
#   Issues: read/write · Pull requests: read/write · Contents: read · Metadata: read
GITHUB_TOKEN=github_pat_...

# Must match the secret configured on the repository webhook. Minimum 16 characters: an empty
# secret still produces a "valid" HMAC, so the service refuses to start without a real one.
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# --- target ------------------------------------------------------------------
GITHUB_REPO=amylase/superset
TRIGGER_LABEL=devin-fix
ESCALATION_LABEL=needs-human
# The login this service writes as. Resolved via GET /user when unset; setting it makes the
# self-comment check deterministic, which is what stops the orchestrator's own escalation comments
# being forwarded back to Devin as human answers.
SELF_LOGIN=

# --- operating envelope ------------------------------------------------------
MAX_CONCURRENT_SESSIONS=2
MAX_ACU_PER_SESSION=20
GLOBAL_ACU_BUDGET=250
MAX_NUDGES=2
MAX_CI_FEEDBACK_ROUNDS=3
# Leave a session alone for this long after sending it anything, so the loop never acts on state
# the session has not had a chance to update.
MESSAGE_GRACE_SECONDS=120
# Backstop for a session that never reaches a recognised ending.
MAX_SESSION_AGE_HOURS=12

# --- loop cadence (seconds) --------------------------------------------------
SESSION_POLL_INTERVAL=10
PR_POLL_INTERVAL=60
RESYNC_INTERVAL=300

# --- reporting assumptions (surfaced on the dashboard, not hidden) -----------
ACU_UNIT_COST_USD=2.25
MANUAL_EFFORT_HOURS_PER_ISSUE=4
ENGINEER_HOURLY_USD=100

# --- optional ----------------------------------------------------------------
# Enables /api/admin/* for driving a demo without waiting on the natural cadence.
# Leave unset to disable the admin API entirely.
ADMIN_TOKEN=
# Attach the playbook created by scripts/bootstrap_devin.py to new sessions.
DEVIN_PLAYBOOK_ID=
DB_PATH=data/orchestrator.db
